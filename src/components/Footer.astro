---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';

const socials = (await getCollection('socials')).sort((a, b) => (a.data.weight ?? 999) - (b.data.weight ?? 999));
---
<footer class="mt-16 border-t border-keene-bark/50 bg-keene-forest text-keene-cream">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-12 md:grid-cols-3">
    <div>
      <h3 class="text-base font-display uppercase tracking-wider text-keene-cream/80">Quick Links</h3>
      <ul class="mt-4 space-y-2 text-base">
        <li><a class="hover:text-keene-chartreuse" href="/courses/">Courses</a></li>
        <li><a class="hover:text-keene-chartreuse" href="/events/">Events & Leagues</a></li>
        <li><a class="hover:text-keene-chartreuse" href="/news/">News</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-base font-display uppercase tracking-wider text-keene-cream/80">Club Info</h3>
      <ul class="mt-4 space-y-2 text-base">
        <li><a class="hover:text-keene-chartreuse" href="/about/">About Us</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-base font-display uppercase tracking-wider text-keene-cream/80">Connect</h3>
      {siteConfig.email && (
        <p class="mt-4 text-base">
          <a href={`mailto:${siteConfig.email}`} class="hover:text-keene-chartreuse">{siteConfig.email}</a>
        </p>
      )}
      <div class="mt-4 flex flex-wrap gap-2">
        {socials.map((social) => (
          <a
            href={social.data.link}
            title={social.data.title}
            class={`rounded-lg border border-keene-cream/40 transition hover:border-keene-chartreuse hover:text-keene-chartreuse ${
              social.data.icon === 'discord'
                ? 'inline-flex h-10 w-10 items-center justify-center'
                : 'px-3 py-1 text-base font-display uppercase tracking-wide'
            }`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.data.icon === 'discord' ? (
              <>
                <svg viewBox="0 0 127.14 96.36" class="h-5 w-5" aria-hidden="true" fill="currentColor">
                  <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47.11a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64.11a105.89 105.89 0 0 0-26.25 7.98C2.79 32.65-1.71 56.6.54 80.21h0A105.73 105.73 0 0 0 32.71 96.36 77.7 77.7 0 0 0 39.6 85.25a68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2.06a75.57 75.57 0 0 0 64.32 0c.87.72 1.76 1.4 2.67 2.06a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1A105.25 105.25 0 0 0 126.6 80.22h0c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.16 65.69 31 59.93 31 52.85S36 40 42.45 40s11.46 5.81 11.43 12.84-5.04 12.85-11.43 12.85Zm42.24 0c-6.29 0-11.43-5.76-11.43-12.84S78.32 40 84.69 40s11.46 5.81 11.43 12.84-5.04 12.85-11.43 12.85Z" />
                </svg>
                <span class="sr-only">{social.data.title}</span>
              </>
            ) : (
              social.data.title
            )}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-keene-cream/20">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-6 py-4 text-base text-keene-cream/75 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {siteConfig.clubName}. All rights reserved.</p>
      <div class="flex gap-4">
        <a class="hover:text-keene-chartreuse" href="https://www.discgolfscene.com/club/2129/keene-disc-golf-club">Disc Golf Scene</a>
        <a class="hover:text-keene-chartreuse" href={siteConfig.udiscURL}>UDisc</a>
        <a class="hover:text-keene-chartreuse" href="https://astro.build">Powered by Astro</a>
      </div>
    </div>
  </div>
</footer>
