---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const page = await getEntry('site', 'connect');
const { Content } = page ? await render(page) : { Content: null };

const socials = (await getCollection('socials')).sort((a, b) => (a.data.weight ?? 999) - (b.data.weight ?? 999));
---
<BaseLayout title={page?.data.title ?? 'Connect'} description={page?.data.description}>
  <article>
    <header class="page-header">
      <h1 class="font-display text-5xl">{page?.data.title ?? 'Connect'}</h1>
    </header>

    <div class="mx-auto w-full max-w-5xl px-6 py-12">
      <div class="surface-panel overflow-hidden bg-gradient-to-r from-keene-forest to-keene-olive text-keene-cream">
        <div class="grid gap-6 p-8 sm:grid-cols-[auto_1fr] sm:items-start sm:p-10">
          <img src={siteConfig.logo} alt="Keene Disc Golf Club logo" class="mx-auto h-24 w-24 sm:mx-0" loading="lazy" />

          <div>
            <p class="text-base font-display uppercase tracking-[0.22em] text-keene-cream/80">Primary Community Hub</p>
            <h2 class="mt-3 font-display text-4xl">Follow Keene Disc Golf Club on Facebook</h2>
            <p class="mt-3 max-w-2xl text-base leading-7 text-keene-cream/95 sm:text-lg">
              Find event details and signups on our page, and course updates in each course's group.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              {socials.map((social, index) => (
                <a
                  href={social.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={index === 0
                    ? 'rounded-lg bg-keene-cream px-5 py-3 text-base font-display uppercase tracking-wide text-keene-forest transition hover:bg-keene-sand'
                    : 'rounded-lg border border-keene-cream/40 px-5 py-3 text-base font-display uppercase tracking-wide text-keene-cream transition hover:bg-white/10'}
                >
                  {social.data.title}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <section class="surface-panel mt-10 p-6 sm:p-8" aria-labelledby="contact-title">
        <p class="text-sm font-display uppercase tracking-[0.22em] text-keene-blue">Contact the Club</p>
        <h2 id="contact-title" class="mt-3 text-3xl text-keene-bark sm:text-4xl">Reach us via email</h2>
        <p class="mt-4 text-base leading-7 text-stone-700">
          Questions about membership, lost discs, events, or volunteering? Send us a note.
        </p>
        <a
          href={`mailto:${siteConfig.email}`}
          class="mt-6 inline-flex rounded-lg bg-keene-olive px-5 py-3 text-base font-display uppercase tracking-wide text-white transition hover:bg-keene-blue"
        >
          {siteConfig.email}
        </a>
      </section>

      {Content && <div class="prose prose-stone mt-10 max-w-none prose-headings:font-display prose-headings:uppercase prose-headings:tracking-wide prose-a:text-keene-blue"><Content /></div>}
    </div>
  </article>
</BaseLayout>
