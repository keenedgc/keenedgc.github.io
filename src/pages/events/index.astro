---
import { getCollection, getEntry, render } from 'astro:content';
import EventCalendar from '../../components/EventCalendar';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toCalendarEvents } from '../../utils/calendarEvents';
import { isEventUpcoming } from '../../utils/eventStatus';

const section = await getEntry('sections', 'events');
const { Content: SectionContent } = section ? await render(section) : { Content: null };

const events = await getCollection('events');
const calendarEvents = toCalendarEvents(events);
const learn = [];
const play = [];
const serve = [];
const past = [];

for (const event of events) {
  const type = event.data.event_type;
  if (!isEventUpcoming(event)) {
    if (type !== 'League') {
      past.push(event);
    }
    continue;
  }

  if (type === 'Clinic') {
    learn.push(event);
  } else if (type === 'Tournament' || type === 'League' || type === 'Casual Round') {
    play.push(event);
  } else if (type === 'Work Day' || type === 'Other') {
    serve.push(event);
  } else {
    past.push(event);
  }
}

learn.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
play.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
serve.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
past.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const learnEvents = learn.slice(0, 3);
const playEvents = play.slice(0, 5);
const serveEvents = serve.slice(0, 3);

const formatDay = (date: Date) => date.toLocaleDateString('en-US', { day: 'numeric' });
const formatMonth = (date: Date) => date.toLocaleDateString('en-US', { month: 'short' });
const formatFullDate = (date: Date) =>
  date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const fmtDate = (date: Date) => date.toISOString().slice(0, 10);
---
<BaseLayout title={section?.data.title ?? 'Events & Leagues'} description={section?.data.description}>
  <article>
    <header class="page-header">
      <h1 class="font-display text-5xl">{section?.data.title ?? 'Events & Leagues'}</h1>
      {section?.data.description && <p class="mx-auto mt-3 max-w-2xl px-6 text-keene-cream/90">{section.data.description}</p>}
    </header>

    <div class="mx-auto w-full max-w-5xl px-6 py-12">
      {SectionContent && (
        <div class="prose prose-stone max-w-none prose-headings:font-display prose-headings:uppercase prose-headings:tracking-wide prose-a:text-keene-blue">
          <SectionContent />
        </div>
      )}

      <section class="mt-10">
        <h2 class="font-display text-4xl text-keene-forest">Calendar</h2>
        <div class="surface-panel mt-5 p-4 sm:p-6">
          <EventCalendar client:load events={calendarEvents} />
        </div>
      </section>

      {learnEvents.length > 0 && (
        <section class="mt-10">
          <h2 class="font-display text-4xl text-keene-forest">Learn</h2>
          <p class="mt-2 text-stone-700">Clinics and skill-building events to help players improve and learn together.</p>
          <div class="mt-5 space-y-4">
            {learnEvents.map((event) => (
              <article class="surface-panel flex gap-4 p-4">
                <div class="flex min-w-20 flex-col items-center justify-center rounded-lg bg-keene-forest px-3 py-2 text-white">
                  <p class="text-base font-display uppercase tracking-wide">{formatMonth(event.data.date)}</p>
                  <p class="text-2xl font-display">{formatDay(event.data.date)}</p>
                </div>
                <div>
                  <h3 class="font-display text-2xl text-keene-forest"><a href={`/events/${event.id}/`} class="hover:text-keene-blue">{event.data.title}</a></h3>
                  {event.data.location && <p class="mt-1 text-base text-stone-700">{event.data.location}</p>}
                  <div class="mt-2 flex flex-wrap gap-2">
                    <p class="inline-flex rounded-lg bg-keene-sand px-3 py-1 text-base font-display uppercase tracking-wide text-keene-bark">{event.data.event_type}</p>
                    {event.data.tentative && (
                      <p class="inline-flex rounded-lg bg-keene-crimson px-3 py-1 text-base font-display uppercase tracking-wide text-white">Tentative</p>
                    )}
                  </div>
                  <div class="mt-2">
                    <a href={`/events/${event.id}/`} class="text-base font-display uppercase tracking-wide text-keene-blue hover:text-keene-crimson">Learn more</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {playEvents.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-4xl text-keene-forest">Play</h2>
          <p class="mt-2 text-stone-700">Tournaments, leagues, and casual rounds for all experience levels and play styles.</p>
          <div class="mt-5 space-y-5">
            {playEvents.map((event) => {
              const weekday = event.data.weekday ?? event.data.day;
              const recurring = Boolean(weekday && event.data.time);
              return (
                <article
                  class="surface-panel p-5"
                  data-recurring-league={recurring ? true : undefined}
                  data-weekday={recurring ? weekday : undefined}
                  data-time={recurring ? event.data.time : undefined}
                  data-season-start={recurring && event.data.season_start ? fmtDate(event.data.season_start) : undefined}
                  data-season-end={recurring && event.data.season_end ? fmtDate(event.data.season_end) : undefined}
                >
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <div class="flex flex-wrap gap-2">
                        <p class="inline-flex rounded-lg bg-keene-sand px-3 py-1 text-base font-display uppercase tracking-wide text-keene-bark">{event.data.event_type}</p>
                        {event.data.tentative && (
                          <p class="inline-flex rounded-lg bg-keene-crimson px-3 py-1 text-base font-display uppercase tracking-wide text-white">Tentative</p>
                        )}
                      </div>
                      <h3 class="mt-3 font-display text-3xl text-keene-forest"><a href={`/events/${event.id}/`} class="hover:text-keene-blue">{event.data.title}</a></h3>
                    </div>
                    {!recurring && (
                      <div class="rounded-lg bg-keene-forest px-3 py-2 text-center text-white">
                        <p class="text-base font-display uppercase tracking-wide">{formatMonth(event.data.date)}</p>
                        <p class="text-2xl font-display">{formatDay(event.data.date)}</p>
                      </div>
                    )}
                  </div>

                  <div class={`mt-4 grid gap-4 ${event.data.image ? 'lg:grid-cols-2 lg:items-start' : ''}`}>
                    {event.data.image && (
                      <img
                        src={event.data.image}
                        alt={event.data.title}
                        class="h-56 w-full rounded-lg object-cover sm:h-64"
                        loading="lazy"
                      />
                    )}
                    <div class="grid gap-3 sm:grid-cols-2">
                      {recurring ? (
                        <>
                          {event.data.day && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Day</p><p class="text-stone-800">{event.data.day}</p></div>
                          )}
                          {event.data.time && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Time</p><p class="text-stone-800">{event.data.time}</p></div>
                          )}
                          <div class="sm:col-span-2"><p class="text-base font-display uppercase tracking-wide text-stone-500">Next</p><p class="text-keene-blue" data-next-occurrence>Next occurrence will appear here.</p></div>
                          {event.data.location && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Location</p><p class="text-stone-800">{event.data.location}</p></div>
                          )}
                          {event.data.format && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Format</p><p class="text-stone-800">{event.data.format}</p></div>
                          )}
                          {event.data.cost && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Cost</p><p class="text-stone-800">{event.data.cost}</p></div>
                          )}
                        </>
                      ) : (
                        <>
                          <div class="sm:col-span-2">
                            <p class="text-base font-display uppercase tracking-wide text-stone-500">Date</p>
                            <p class="text-stone-800">
                              <time datetime={event.data.date.toISOString()}>{formatFullDate(event.data.date)}</time>
                            </p>
                          </div>
                          {event.data.time && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Time</p><p class="text-stone-800">{event.data.time}</p></div>
                          )}
                          {event.data.location && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Location</p><p class="text-stone-800">{event.data.location}</p></div>
                          )}
                          {event.data.format && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Format</p><p class="text-stone-800">{event.data.format}</p></div>
                          )}
                          {event.data.cost && (
                            <div><p class="text-base font-display uppercase tracking-wide text-stone-500">Cost</p><p class="text-stone-800">{event.data.cost}</p></div>
                          )}
                        </>
                      )}
                    </div>
                  </div>

                  {event.data.description && <p class="mt-4 text-base leading-6 text-stone-700">{event.data.description}</p>}

                  <div class="mt-5 flex flex-wrap gap-3">
                    {event.data.registration_link && (
                      <a href={event.data.registration_link} class="rounded-lg bg-keene-olive px-4 py-2 text-base font-display uppercase tracking-wide text-white transition hover:bg-keene-forest">
                        {event.data.event_type === 'League' ? 'Sign Up' : 'Register'}
                      </a>
                    )}
                    <a href={`/events/${event.id}/`} class="rounded-lg border border-[#D4C9B8] bg-[#FAF8F5] px-4 py-2 text-base font-display uppercase tracking-wide text-keene-bark transition hover:bg-keene-sand">Learn More</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {serveEvents.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-4xl text-keene-forest">Serve</h2>
          <p class="mt-2 text-stone-700">Work days and community support events that help keep local courses welcoming and playable.</p>
          <div class="mt-5 space-y-4">
            {serveEvents.map((event) => (
              <article class="surface-panel flex gap-4 p-4">
                <div class="flex min-w-20 flex-col items-center justify-center rounded-lg bg-keene-forest px-3 py-2 text-white">
                  <p class="text-base font-display uppercase tracking-wide">{formatMonth(event.data.date)}</p>
                  <p class="text-2xl font-display">{formatDay(event.data.date)}</p>
                </div>
                <div>
                  <h3 class="font-display text-2xl text-keene-forest"><a href={`/events/${event.id}/`} class="hover:text-keene-blue">{event.data.title}</a></h3>
                  {event.data.location && <p class="mt-1 text-base text-stone-700">{event.data.location}</p>}
                  <div class="mt-2 flex flex-wrap gap-2">
                    <p class="inline-flex rounded-lg bg-keene-sand px-3 py-1 text-base font-display uppercase tracking-wide text-keene-bark">{event.data.event_type}</p>
                    {event.data.tentative && (
                      <p class="inline-flex rounded-lg bg-keene-crimson px-3 py-1 text-base font-display uppercase tracking-wide text-white">Tentative</p>
                    )}
                  </div>
                  <div class="mt-2">
                    <a href={`/events/${event.id}/`} class="text-base font-display uppercase tracking-wide text-keene-blue hover:text-keene-crimson">Learn more</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {past.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-4xl text-keene-forest">Past Events</h2>
          <div class="mt-5 space-y-4">
            {past.map((event) => (
              <article class="surface-panel flex gap-4 p-4 opacity-90">
                <div class="flex min-w-20 flex-col items-center justify-center rounded-lg bg-keene-bark px-3 py-2 text-white">
                  <p class="text-base font-display uppercase tracking-wide">{formatMonth(event.data.date)}</p>
                  <p class="text-2xl font-display">{formatDay(event.data.date)}</p>
                </div>
                <div>
                  <h3 class="font-display text-2xl text-keene-forest"><a href={`/events/${event.id}/`} class="hover:text-keene-blue">{event.data.title}</a></h3>
                  {event.data.location && <p class="mt-1 text-base text-stone-700">{event.data.location}</p>}
                  <div class="mt-2 flex flex-wrap gap-2">
                    <p class="inline-flex rounded-lg bg-stone-200 px-3 py-1 text-base font-display uppercase tracking-wide text-stone-600">{event.data.event_type}</p>
                    {event.data.tentative && (
                      <p class="inline-flex rounded-lg bg-keene-crimson px-3 py-1 text-base font-display uppercase tracking-wide text-white">Tentative</p>
                    )}
                  </div>
                  {event.data.results_link && (
                    <div class="mt-3">
                      <a
                        href={event.data.results_link}
                        class="inline-flex rounded-lg bg-keene-olive px-4 py-2 text-base font-display uppercase tracking-wide text-white transition hover:bg-keene-forest"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View Results
                      </a>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {learnEvents.length === 0 && playEvents.length === 0 && serveEvents.length === 0 && past.length === 0 && <p>No events scheduled at the moment. Check back soon!</p>}
    </div>
  </article>
</BaseLayout>
