---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({ params: { slug: course.id }, props: { course } }));
}

const { course } = Astro.props;
const { Content } = await render(course);
---
<BaseLayout title={course.data.title} description={course.data.description} image={course.data.image}>
  <article>
    <header class="page-header">
      <h1 class="font-display text-5xl">{course.data.title}</h1>
    </header>

    <div class="mx-auto w-full max-w-5xl px-6 py-12">
      <div class="grid gap-6 lg:grid-cols-[2fr_1fr]">
        <div class="self-start overflow-hidden rounded-lg border border-[#D4C9B8] bg-white">
          {course.data.image ? (
            <div class="h-[18rem] max-h-[60vh] sm:h-[20rem] lg:h-[24rem]">
              <img
                src={course.data.image}
                alt={course.data.title}
                class="h-full w-full object-cover"
              />
            </div>
          ) : (
            <div class="h-full min-h-72 bg-keene-sand"></div>
          )}
        </div>

        <aside class="surface-panel p-5">
          {course.data.location && <div><h2 class="text-base font-display uppercase tracking-wide text-stone-500">Location</h2><p class="mt-1 text-stone-800">{course.data.location}</p></div>}
          {course.data.holes && <div class="mt-4"><h2 class="text-base font-display uppercase tracking-wide text-stone-500">Holes</h2><p class="mt-1 text-stone-800">{course.data.holes}</p></div>}
          {course.data.difficulty && <div class="mt-4"><h2 class="text-base font-display uppercase tracking-wide text-stone-500">Difficulty</h2><p class="mt-1"><span class="rounded-lg bg-keene-blue/10 px-3 py-1 text-base font-display uppercase tracking-wide text-keene-blue">{course.data.difficulty}</span></p></div>}
          {course.data.udisc_link && (
            <div class="mt-6">
              <a
                href={course.data.udisc_link}
                class="inline-flex rounded-lg bg-keene-olive px-4 py-2 text-base font-display uppercase tracking-wide text-white transition hover:bg-keene-forest"
                target="_blank"
                rel="noopener noreferrer"
              >
                View on UDisc
              </a>
            </div>
          )}
        </aside>
      </div>

      <div class="prose prose-stone mt-10 max-w-none prose-headings:font-display prose-headings:uppercase prose-headings:tracking-wide prose-a:text-keene-blue">
        <Content />
      </div>

      <div class="mt-10">
        <a href="/courses/" class="text-base font-display uppercase tracking-wide text-keene-blue hover:text-keene-crimson">Back to Courses</a>
      </div>
    </div>
  </article>
</BaseLayout>
